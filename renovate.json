{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
	"timezone": "Europe/Zurich",
	"schedule": ["before 6am on monday"],
	"minimumReleaseAge": "7 days",
	"packageRules": [
		{
			"matchManagers": ["bun", "npm"],
			"groupName": "dependencies"
		},
		{
			"matchManagers": ["github-actions"],
			"groupName": "github actions"
		},
		{
			"matchManagers": ["dockerfile", "docker-compose"],
			"groupName": "images"
		},
		{
			"description": "Small updates merge themselves once CI is green",
			"matchUpdateTypes": ["patch", "digest", "pinDigest"],
			"automerge": true
		},
		{
			"description": "The PocketBase host gives no release dates; without this, minimumReleaseAge holds every update back",
			"matchDepNames": ["pocketbase"],
			"minimumReleaseAgeBehaviour": "timestamp-optional"
		}
	],
	"customManagers": [
		{
			"description": "PocketBase in the image; the local binary must match it (.claude/rules/release-deployment.md)",
			"customType": "regex",
			"managerFilePatterns": ["/^docker/pocketbase/Dockerfile$/"],
			"matchStrings": ["ARG PB_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
			"depNameTemplate": "pocketbase",
			"datasourceTemplate": "custom.pocketbase"
		}
	],
	"customDatasources": {
		"pocketbase": {
			"description": "PocketBase moved off GitHub in 0.41.0; its new host lists the git refs as JSON",
			"defaultRegistryUrlTemplate": "https://ganigeorgiev.com/api/git/pocketbase/pocketbase/refs",
			"transformTemplates": [
				"{\"releases\": [$[$match(name, /^refs\\/tags\\/v\\d+\\.\\d+\\.\\d+$/)].{\"version\": $substringAfter(name, \"refs/tags/v\")}]}"
			]
		}
	}
}
