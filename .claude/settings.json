{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(bun run:*)",
      "Bash(bunx:*)",
      "Bash(bunx vitest:*)",
      "Bash(pre-commit run:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(chmod +x:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git clean -f:*)",
      "Bash(kubectl delete:*)",
      "Bash(docker system prune:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0"
  },
  "includeCoAuthoredBy": false,
  "respectGitignore": true
}
